    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug rusteze",
            "cargo": {
                "args": [ "build", "--bin=rusteze", "--package=rusteze" ],
                "filter": {
                    "name": "rusteze",
                    "kind": "bin"
                }
            },
            "args": [ ],
            "cwd": "${workspaceFolder}"
        }
    ]
}
