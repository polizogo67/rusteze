    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug server",
            "cargo": {
                "args": [ "build", "--bin=server", "--package=rusteze" ],
                "filter": {
                    "name": "server",
                    "kind": "bin"
                }
            },
            "args": [ ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug cli",
            "cargo": {
                "args": [ "build", "--bin=cli", "--package=rusteze" ],
                "filter": {
                    "name": "cli",
                    "kind": "bin"
                }
            },
            "args": [ ],
            "cwd": "${workspaceFolder}"
        }
    ]
}
